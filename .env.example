# ==============================================================================
# Jyot Multimodal Monitor Configuration
# Track B (Extended) — Agentic Multimodal Monitor with OCR
# ==============================================================================

# Database path (SQLite)
DATABASE_PATH=data/jyot_monitor.db

# LLM & Vision Model Configuration (Ollama or compatible local endpoint)
OLLAMA_BASE_URL=http://localhost:11434
PLANNER_MODEL=llama3.2
VISION_MODEL=llava
LLM_TIMEOUT_SECONDS=15
LLM_TEMPERATURE=0.1

# OCR Settings
TESSERACT_CMD=tesseract
OCR_CONFIDENCE_THRESHOLD=60.0
OCR_PREPROCESSING_PROFILE=standard

# Agent Limits & Budgets
MAX_STEPS_PER_ITEM=6
ITEM_BUDGET_USD=0.05
RUN_BUDGET_USD=1.00
URGENCY_THRESHOLD_FOR_ALERT=75.0

# Network Safety & Ingestion Limits
MAX_ATTACHMENT_SIZE_MB=10
FETCH_TIMEOUT_SECONDS=8
MAX_REDIRECTS=3
ALLOWED_SCHEMES=http,https

# Environment
JYOT_ENV=development
